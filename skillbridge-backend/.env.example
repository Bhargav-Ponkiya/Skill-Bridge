# ========================
# Application
# ========================
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# ========================
# Database (Neon in prod / local Docker in dev)
# ========================
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/skillbridge

# ========================
# Redis (Upstash in prod / local Docker in dev)
# ========================
REDIS_URL=redis://localhost:6379

# ========================
# RabbitMQ (CloudAMQP in prod / local Docker in dev)
# ========================
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# ========================
# JWT Authentication (secrets must be 32+ characters each)
# ========================
JWT_SECRET=change_me_to_a_random_64_char_string
JWT_REFRESH_SECRET=change_me_to_a_different_random_64_char_string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ========================
# Google OAuth
# ========================
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

# ========================
# Gemini AI (Google AI Studio)
# ========================
GEMINI_API_KEY=your_gemini_api_key
# Comma-separated list of summary-model candidates, tried in order on rate-limit / quota errors.
GEMINI_SUMMARY_MODELS=gemini-2.0-flash-lite,gemini-flash-latest,gemini-2.5-flash,gemini-2.0-flash

# ========================
# PulseBoard Logging
# ========================
PULSEBOARD_INGEST_URL=https://pulseboard-ingestor-service.onrender.com/ingest/logs
PULSEBOARD_API_KEY=your_pulseboard_api_key_here
